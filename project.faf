faf_version: "3.0"
project:
  name: rust-mcp-preflight
  goal: Check an MCP Registry listing before you publish it.
  main_language: Rust
  type: mcp
stack:
  frontend: slotignored
  css_framework: slotignored
  ui_library: slotignored
  state_management: slotignored
  backend: slotignored
  api_type: slotignored
  runtime: slotignored
  database: slotignored
  connection: slotignored
  hosting: crates.io (cargo install)
  build: cargo
  cicd: GitHub Actions
  monorepo_tool: slotignored
  package_manager: slotignored
  workspaces: slotignored
  admin: slotignored
  cache: slotignored
  search: slotignored
  storage: slotignored
human_context:
  who: Developers listing an MCP server in the official MCP Registry, starting with Rust servers on crates.io
  what: "Run the registry's publish checks before publishing: server.json, the crates.io README line, the server name and its namespace login"
  why: mcp-publisher validate checks the shape of server.json, not ownership; the README check only runs at publish, after the crate version is final
  where: On a developer's machine or in CI, as a CLI or a stdio MCP server; reads crates.io, the MCP Registry, the GitHub users API and a domain's DNS TXT and .well-known key
  when: In use since November 2026; checked every week against the live services and the registry's own rules
  how: Ports the registry's own validators and login checks from its Go source and runs them against the live services, so it decides as the registry would
monorepo:
  packages_count: slotignored
  build_orchestrator: slotignored
  versioning_strategy: slotignored
  shared_configs: slotignored
  remote_cache: slotignored
tech_stack:
  - Rust
key_files:
  - Cargo.toml
  - src/main.rs
  - src/checks.rs
  - src/token.rs
  - src/auth.rs
  - src/server.rs
  - README.md
commands:
  build: cargo build --release
  test: cargo test
