faf_version: "3.0"
project:
  name: rust-mcp-preflight
  goal: Check an MCP Registry listing before you publish it.
  main_language: Rust
  type: mcp
stack:
  frontend: slotignored
  css_framework: slotignored
  ui_library: slotignored
  state_management: slotignored
  backend: slotignored
  api_type: slotignored
  runtime: slotignored
  database: slotignored
  connection: slotignored
  hosting: crates.io (cargo install)
  build: cargo
  cicd: GitHub Actions
  monorepo_tool: slotignored
  package_manager: slotignored
  workspaces: slotignored
  admin: slotignored
  cache: slotignored
  search: slotignored
  storage: slotignored
human_context:
  who: Developers listing an MCP server in the official MCP Registry, starting with Rust servers on crates.io
  what: Check an MCP Registry listing before you publish it.
  why: mcp-publisher validate checks the shape of server.json, not ownership; the README check only runs at publish, after the crate version is final
  where: Locally over stdio in an MCP client, or as a CLI in a terminal or CI; reads crates.io, registry.modelcontextprotocol.io and the GitHub users API
  when: Before every mcp-publisher publish, after cargo publish
  how: cargo install rust-mcp-preflight, then rust-mcp-preflight server.json (or claude mcp add preflight -- rust-mcp-preflight)
monorepo:
  packages_count: slotignored
  build_orchestrator: slotignored
  versioning_strategy: slotignored
  shared_configs: slotignored
  remote_cache: slotignored
tech_stack:
  - Rust
key_files:
  - Cargo.toml
  - src/main.rs
  - src/checks.rs
  - src/token.rs
  - README.md
commands:
  build: cargo build --release
  test: cargo test
